{
  "name": "cofound-bp-desk",
  "version": "1.3.0",
  "private": true,
  "description": "Independent, local-first investment workbench and Codex plugin for evidence-bound BP analysis, controlled collaboration and optional CleanTech enhancement.",
  "type": "module",
  "license": "MIT",
  "author": "Cofound Investment Office contributors",
  "homepage": "https://github.com/wulie0508-gif/cofound-investment-office#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wulie0508-gif/cofound-investment-office.git"
  },
  "bugs": {
    "url": "https://github.com/wulie0508-gif/cofound-investment-office/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch server/_core/index.ts",
    "build": "vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "build:web": "vite build",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "skills:verify": "tsx scripts/verify-cofound-skills.ts",
    "seed": "tsx scripts/seed-demo.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "ocr:smoke": "tsx scripts/ocr-smoke.ts",
    "browser:verify": "tsx scripts/browser-verify.ts",
    "ui:verify": "tsx scripts/ui-verify.ts",
    "portfolio:import": "tsx scripts/import-test-portfolio.ts",
    "portfolio:publish": "tsx scripts/publish-test-portfolio.ts",
    "lite:browser:verify": "tsx scripts/lite-browser-verify.ts",
    "db:vercel:migrate": "tsx scripts/migrate-vercel-lite.ts",
    "icon:build": "node scripts/generate-app-icon.mjs",
    "plugin:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-codex-plugin.ps1",
    "shortcut:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-desktop-shortcut.ps1",
    "release:verify": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify-release.ps1"
  },
