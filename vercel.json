{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "corepack pnpm@10.34.5 install --frozen-lockfile",
  "buildCommand": "corepack pnpm@10.34.5 build:web",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "functions": {
    "api/lite.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/share/:path*",
      "destination": "/index.html"
    }
  ]
}
