# local（默认）只监听 127.0.0.1；shared 用于公司自有云/持久化服务器。
COF_BP_MODE=local
COF_BP_HOST=127.0.0.1
COF_BP_PORT=4010
COF_BP_DATA_DIR=./data

# 内部 BP 原件与补充材料通过已授权的 lark-cli（用户身份）追加到飞书。
# 配置只保存 Drive / Base 定位符，不保存飞书凭据；默认读取 data/feishu-internal-storage.json。
# COF_BP_FEISHU_CONFIG=./data/feishu-internal-storage.json
# V1 保留全部 BP 版本，不覆盖、不删除、不自动归档。

# Vercel Lite：本机只在管理员明确发布时，把选定字段和选定文件同步到网站。
# 远端地址填写 Vercel 部署域名；同步令牌需与 Vercel 环境变量保持一致。
COF_BP_LITE_REMOTE_URL=https://your-project.example
COF_BP_LITE_SYNC_TOKEN=<set-a-long-random-secret>

# 以下三项仅由 Vercel Lite 云端使用。Neon / Vercel Blob 连接后会自动注入前两项。
DATABASE_URL=<set-in-your-hosting-provider>
BLOB_READ_WRITE_TOKEN=<set-in-vercel>
# COF_BP_PUBLIC_BASE_URL 可留空；留空时按当前访问域名生成分享链接。
COF_BP_PUBLIC_BASE_URL=https://your-project.example

# 下列账号变量只用于可选的公司私有化完整版，不是 Vercel Lite 的必需项。
COF_BP_ADMIN_EMAIL=leader@example.com
COF_BP_ADMIN_NAME=Cofound Admin
COF_BP_ADMIN_BOOTSTRAP_PASSWORD=<set-a-long-random-password>

# 邮箱验证码。配置后由 Supabase Auth 发送并校验 OTP；未配置时仅在 127.0.0.1
# 提供可见的本机测试验证码，shared / Vercel 环境不会降级为测试模式。
SUPABASE_URL=https://your-project.example
SUPABASE_ANON_KEY=<set-in-supabase>

# 设为 0 可关闭扫描 PDF 的离线 OCR。默认启用中英文 OCR。
COF_BP_OCR=1
COF_BP_OCR_MAX_PAGES=80
# Optional local WeChat File Transfer Assistant BP inbox.
# The default trigger is intentionally different from the private RAG trigger.
COF_BP_WECHAT_TRIGGER=存入项目库
# COF_BP_WECHAT_FILES_DIRS=C:\Users\you\Documents\xwechat_files\wxid_xxx\msg\file
# WECHAT_CONTENT_ROUTER_ROOT=C:\Users\you\.codex\skills\wechat-content-router-windows
# COF_BP_PYTHON=python
# COF_BP_WECHAT_SCAN_SECONDS=120

# Optional immutable CleanTech Finance sidecar. Do not point this at a mutable
# development worktree. Until configured, Cofound remains fully usable and the
# CleanTech enhancement reports unavailable_runtime.
# COF_CLEANTECH_RELEASE_ROOT=C:\\Tools\\CleanTech-Finance-BP-v0.5.0
# COF_CLEANTECH_PYTHON=C:\\Tools\\CleanTech-Finance-BP-v0.5.0\\.venv\\Scripts\\python.exe
# These private files contain Feishu Base locators and must remain outside Git.
# COF_POLICY_BASE_CONFIG=C:\\Private\\cleantech-policy-base.json
# COF_PROJECT_BASE_CONFIG=C:\\Private\\cleantech-project-base.json
# Set only after user-scoped lark-cli authentication and read-only policy/project
# catalog acceptance tests have passed.
# COF_CLEANTECH_FEISHU_READY=1
